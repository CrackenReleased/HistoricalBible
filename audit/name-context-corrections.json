{
  "identities": {
    "Shadrach": {
      "text": "Hananiah, named Shadrach at the Babylonian court. With Mishael and Azariah, he refused to serve the king’s gods or worship the golden image, even if God did not deliver them. God delivered them from the furnace.",
      "refs": [
        "Dan.1.6",
        "Dan.1.7",
        "Dan.3.16",
        "Dan.3.17",
        "Dan.3.18",
        "Dan.3.27",
        "Dan.3.28"
      ]
    },
    "Meshach": {
      "text": "Mishael, named Meshach at the Babylonian court. He stood with Hananiah and Azariah in refusing the king’s idolatry. God delivered the three from the furnace.",
      "refs": [
        "Dan.1.6",
        "Dan.1.7",
        "Dan.3.16",
        "Dan.3.17",
        "Dan.3.18",
        "Dan.3.27",
        "Dan.3.28"
      ]
    },
    "Abednego": {
      "text": "Azariah, given the Babylonian name Abed-nego. With Hananiah and Mishael, he refused to worship the golden image. God delivered the three from the furnace.",
      "refs": [
        "Dan.1.6",
        "Dan.1.7",
        "Dan.3.16",
        "Dan.3.18",
        "Dan.3.27",
        "Dan.3.28"
      ]
    },
    "Hananiah": {
      "text": "Daniel’s companion Hananiah was given the name Shadrach and stood with Mishael and Azariah against the king’s idolatry. Other people in Scripture also bear the name Hananiah; these references must be read in context.",
      "refs": [
        "Dan.1.6",
        "Dan.1.7",
        "Dan.3.16",
        "Dan.3.18"
      ]
    },
    "Mishael": {
      "text": "Daniel’s companion Mishael was given the name Meshach and stood with Hananiah and Azariah against the king’s idolatry. Other people in Scripture also bear this name.",
      "refs": [
        "Dan.1.6",
        "Dan.1.7",
        "Dan.3.16",
        "Dan.3.18"
      ]
    },
    "Azariah": {
      "text": "Daniel’s companion Azariah was given the name Abed-nego and stood with Hananiah and Mishael against the king’s idolatry. Many other people in Scripture bear the name Azariah.",
      "refs": [
        "Dan.1.6",
        "Dan.1.7",
        "Dan.3.16",
        "Dan.3.18"
      ]
    },
    "Noah": {
      "text": "This spelling names both Noah, who found grace in the eyes of the LORD, and Noah, a daughter of Zelophehad. Their identities and proposed name derivations must remain distinct.",
      "refs": [
        "Gen.6.8",
        "Num.26.33"
      ]
    },
    "Rahab": {
      "text": "Joshua’s account names the woman Rahab. Other passages use Rahab in a different context, including Egypt; the same English spelling must not collapse these references into one person.",
      "refs": [
        "Josh.2.1",
        "Heb.11.31",
        "Ps.87.4",
        "Isa.51.9"
      ]
    },
    "Eli": {
      "text": "Eli is the priest named in Samuel. In Matthew 27:46, Eli is part of the Lord Jesus’s cry, which the verse interprets as My God. Those uses are distinct.",
      "refs": [
        "1Sam.1.9",
        "Matt.27.46"
      ]
    },
    "Jesus": {
      "text": "Jesus Christ is the Son of God and Saviour. The same English name also appears for Joshua in Acts 7:45 and Hebrews 4:8, and for Jesus called Justus in Colossians 4:11. Read each occurrence in its context.",
      "refs": [
        "Matt.1.21",
        "John.20.31",
        "Acts.7.45",
        "Heb.4.8",
        "Col.4.11"
      ]
    },
    "Paul": {
      "text": "Acts 13:9 identifies Saul as also called Paul. It does not say that his name was changed at his conversion.",
      "refs": [
        "Acts.13.9"
      ]
    },
    "Saul": {
      "text": "This name is borne by different men, including Israel’s king and the apostle also called Paul. Acts 13:9 says also called Paul; it does not describe a conversion-time renaming.",
      "refs": [
        "1Sam.9.2",
        "Acts.13.9"
      ]
    },
    "Belteshazzar": {
      "text": "The Babylonian court name given to Daniel by the prince of the eunuchs. Daniel and Belshazzar, the king named in Daniel 5, are different people.",
      "refs": [
        "Dan.1.7",
        "Dan.5.1"
      ]
    },
    "Jehovah": {
      "text": "The KJV prints the divine name JEHOVAH. Exodus 6:3 and Psalm 83:18 identify it as God’s name. Capitalization in the Scripture text is preserved.",
      "refs": [
        "Exod.6.3",
        "Ps.83.18"
      ]
    },
    "Jah": {
      "text": "Psalm 68:4 calls readers to extol God by his name JAH. This divine name is not an otherwise unidentified human person.",
      "refs": [
        "Ps.68.4"
      ]
    },
    "Mene": {
      "text": "A word in the writing interpreted by Daniel: God hath numbered thy kingdom, and finished it. It is not a person’s name.",
      "refs": [
        "Dan.5.25",
        "Dan.5.26"
      ]
    },
    "Tekel": {
      "text": "A word in the writing interpreted by Daniel: Thou art weighed in the balances, and art found wanting. It is not a person’s name.",
      "refs": [
        "Dan.5.25",
        "Dan.5.27"
      ]
    },
    "Upharsin": {
      "text": "A word in the writing in Daniel 5:25. Daniel’s interpretation in verse 28 uses PERES and declares the kingdom divided and given to the Medes and Persians. It is not a person’s name.",
      "refs": [
        "Dan.5.25",
        "Dan.5.28"
      ]
    },
    "Abba": {
      "text": "An address followed by Father in each of its three KJV occurrences. These passages do not introduce a person named Abba.",
      "refs": [
        "Mark.14.36",
        "Rom.8.15",
        "Gal.4.6"
      ]
    },
    "Rabbi": {
      "text": "A title; John 1:38 explicitly interprets it as Master. It is not a personal name.",
      "refs": [
        "John.1.38"
      ]
    },
    "Selah": {
      "text": "The spelling occurs for a place in 2 Kings 14:7 and also repeatedly in the Psalms. The musical or liturgical term must not be assigned the place’s identity.",
      "refs": [
        "2Kgs.14.7",
        "Ps.3.2"
      ]
    },
    "Shiloh": {
      "text": "The spelling occurs in Jacob’s words in Genesis 49:10 and as a place where the tabernacle was set up in Joshua 18:1. These contexts must not be flattened into one place-name claim.",
      "refs": [
        "Gen.49.10",
        "Josh.18.1"
      ]
    },
    "Arphaxad": {
      "text": "The KJV names Arphaxad among the sons of Shem. A digital lexical record calling him a son of Noah must not override that genealogy.",
      "refs": [
        "Gen.10.22",
        "Gen.11.10"
      ]
    },
    "Javan": {
      "text": "Genesis 10:2 names Javan among the sons of Japheth. A digital lexical record attributing him to Joktan must not override the KJV.",
      "refs": [
        "Gen.10.2"
      ]
    },
    "Lo-ruhamah": {
      "text": "Hosea 1:6 explicitly identifies Lo-ruhamah as a daughter. A digital lexical record calling her a son is inconsistent with that passage.",
      "refs": [
        "Hos.1.6"
      ]
    },
    "Sherah": {
      "text": "First Chronicles 7:24 names Sherah as a daughter and credits her with building Beth-horon the nether and the upper, and Uzzen-sherah.",
      "refs": [
        "1Chr.7.24"
      ]
    },
    "Lahmi": {
      "text": "First Chronicles 20:5 identifies Lahmi as the brother of Goliath the Gittite. A lexical source description must be checked against that context.",
      "refs": [
        "1Chr.20.5"
      ]
    },
    "Rab-shakeh": {
      "text": "The KJV places Rabshakeh among those sent by the king of Assyria against Jerusalem. The lexical record’s Babylonian description must not replace that setting.",
      "refs": [
        "2Kgs.18.17",
        "Isa.36.2"
      ]
    },
    "Sarah": {
      "text": "Sarah is the name God gave Abraham’s wife in Genesis 17:15. Numbers 26:46 also uses Sarah for Asher’s daughter; the shared English spelling does not make them the same woman.",
      "refs": [
        "Gen.17.15",
        "Num.26.46"
      ]
    }
  },
