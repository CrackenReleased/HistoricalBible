{
  "name": "historicalbible-cross-references",
  "version": "00.01.46",
  "type": "module",
  "description": "Interactive KJV Bible Cross-Reference Visualizer (Arcs, Threads, and Entity Loom)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-canonical-kjv.js && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:collection": "node --test tests/collection-regression.ts tests/name-audit-regression.ts tests/data-integrity-selfcheck.ts",
    "test:selfcheck": "node --test tests/data-integrity-selfcheck.ts",
    "test:ui": "playwright test --ui",
    "verify-kjv": "node scripts/verify-canonical-kjv.js",
    "compile-data": "node scripts/build-curated-kjv.js && node scripts/verify-canonical-kjv.js"
  },
  "keywords": [
    "bible",
    "kjv",
    "cross-references",
    "data-visualization",
    "arc-diagram",
    "bibleviz"
  ],
  "author": "HistoricalBible.com",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4"
  }
}
